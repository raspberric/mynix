{
  "languageserver": {
    "angular": {
      "command": "ngserver",
      "args": [
        "--stdio",
        "--tsProbeLocations",
        "./node_modules/typescript/lib",
        "--ngProbeLocations",
        "./node_modules/@angular/language-server/bin"
      ],
      "filetypes": [
        "html",
        "typescript",
        "ts",
        "angular"
      ],
      "trace.server.verobosity": "verbose",
      "rootPatterns": [
        "angular.json",
        "project.json"
      ]
    },
    "astro": {
      "command": "astro-ls",
      "args": [
        "--stdio"
      ],
      "initializationOptions": {
        "typescript": {
          "tsdk": "./node_modules/typescript/lib"
        }
      },
      "filetypes": [
        "astro"
      ],
      "rootPatterns": [
        "astro.config.mjs",
        "package.json",
        ".git"
      ]
    }
  },
  "tsserver.enable": true,
  "tsserver.format.enable": false,
  "tsserver.useLocalTsdk": true,
  "html.validate.scripts": false,
  "html.validate.styles": false,
  "html.format.enable": false,
  "css.format.enable": false,
  "json.format.enable": false,
  "prettier.disableLanguages": [],
  "prettier.formatterPriority": 1,
  "prettier.resolveConfig": true
}
